<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 28+ only: let the game paint into the display cutout area instead
         of being letterboxed beside it. Fire tablets have no cutout, so this
         is purely for phones. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:statusBarColor">@color/game_background</item>
        <item name="android:navigationBarColor">@color/game_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
